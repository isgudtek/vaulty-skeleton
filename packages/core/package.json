{
  "name": "@vaulty/core",
  "version": "0.1.0",
  "description": "Zero-knowledge, zero-dependency client-side vault SDK: pattern-derived keys, plausible deniability, duress wipe, OPFS/IndexedDB storage and portable encrypted archives.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/isgudtek/vaulty-skeleton.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/isgudtek/vaulty-skeleton/tree/main/packages/core#readme",
  "bugs": {
    "url": "https://github.com/isgudtek/vaulty-skeleton/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/react.d.ts",
        "default": "./dist/react.js"
      },
      "require": {
        "types": "./dist/react.d.cts",
        "default": "./dist/react.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsup",
    "prepare": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "check:security": "node scripts/check-security.mjs",
    "prepublishOnly": "npm run typecheck && npm run check:security && npm test"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.1.0",
    "fake-indexeddb": "6.2.8",
    "jsdom": "31.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tsup": "9.0.0",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  },
  "keywords": [
    "zero-knowledge",
    "encryption",
    "web-crypto",
    "vault",
    "opfs",
    "plausible-deniability"
  ]
}
