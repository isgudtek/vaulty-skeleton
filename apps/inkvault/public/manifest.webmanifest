{
  "name": "InkVault — Encrypted Markdown Scratchpad",
  "short_name": "InkVault",
  "description": "Write Markdown normally; save to an encrypted vault only when you choose. Powered by @vaulty/core.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#FAF9F6",
  "theme_color": "#FAF9F6",
  "icons": [
    { "src": "./icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any maskable" },
    { "src": "./icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any maskable" }
  ]
}
